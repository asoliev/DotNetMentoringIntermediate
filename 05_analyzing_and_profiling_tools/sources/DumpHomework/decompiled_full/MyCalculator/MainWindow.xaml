<Window x:Class="MyCalculatorv1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculator" Height="400" Width="300"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- ConnectionId 1: First button (7) - placed before TextBox to match connection ID order -->
        <Button Grid.Row="0" Grid.Column="0" Content="7" FontSize="18" Margin="2" Click="Button_Click_1" Width="60" Height="40"/>
        
        <!-- ConnectionId 2: Display TextBox -->
        <TextBox x:Name="tb" Grid.Row="0" Grid.Column="1"
                 FontSize="24" 
                 TextAlignment="Right" 
                 Padding="10"
                 Margin="10"
                 IsReadOnly="True"
                 Background="White"
                 Height="60"/>
        
        <!-- Button Grid -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- ConnectionIds 3-14: Number and operator buttons (12 buttons) -->
            <!-- Row 1: 8, 9, / -->
            <Button Grid.Row="0" Grid.Column="0" Content="8" FontSize="18" Margin="2" Click="Button_Click_1"/>
            <Button Grid.Row="0" Grid.Column="1" Content="9" FontSize="18" Margin="2" Click="Button_Click_1"/>
            <Button Grid.Row="0" Grid.Column="2" Content="/" FontSize="18" Margin="2" Click="Button_Click_1"/>
            
            <!-- Row 2: 4, 5, 6, * -->
            <Button Grid.Row="1" Grid.Column="0" Content="4" FontSize="18" Margin="2" Click="Button_Click_1"/>
            <Button Grid.Row="1" Grid.Column="1" Content="5" FontSize="18" Margin="2" Click="Button_Click_1"/>
            <Button Grid.Row="1" Grid.Column="2" Content="6" FontSize="18" Margin="2" Click="Button_Click_1"/>
            <Button Grid.Row="1" Grid.Column="3" Content="*" FontSize="18" Margin="2" Click="Button_Click_1"/>
            
            <!-- Row 3: 1, 2, 3, - -->
            <Button Grid.Row="2" Grid.Column="0" Content="1" FontSize="18" Margin="2" Click="Button_Click_1"/>
            <Button Grid.Row="2" Grid.Column="1" Content="2" FontSize="18" Margin="2" Click="Button_Click_1"/>
            <Button Grid.Row="2" Grid.Column="2" Content="3" FontSize="18" Margin="2" Click="Button_Click_1"/>
            <Button Grid.Row="2" Grid.Column="3" Content="-" FontSize="18" Margin="2" Click="Button_Click_1"/>
            
            <!-- ConnectionId 15: = button -->
            <Button Grid.Row="3" Grid.Column="0" Content="=" FontSize="18" Margin="2" Click="Result_click"/>
            
            <!-- ConnectionId 16: 0 button -->
            <Button Grid.Row="3" Grid.Column="1" Content="0" FontSize="18" Margin="2" Click="Button_Click_1"/>
            
            <!-- ConnectionId 17: Off button -->
            <Button Grid.Row="3" Grid.Column="2" Content="Off" FontSize="18" Margin="2" Click="Off_Click_1"/>
            
            <!-- ConnectionId 18: Del button -->
            <Button Grid.Row="3" Grid.Column="3" Content="Del" FontSize="18" Margin="2" Click="Del_Click"/>
            
            <!-- ConnectionId 19: R button -->
            <Button Grid.Row="4" Grid.Column="0" Content="R" FontSize="18" Margin="2" Click="R_Click"/>
            
            <!-- Additional button for + (to complete the layout) -->
            <Button Grid.Row="4" Grid.Column="1" Content="+" FontSize="18" Margin="2" Click="Button_Click_1"/>
        </Grid>
    </Grid>
</Window>

